            <groupId>consulo</groupId>
            <artifactId>consulo-compiler-impl</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- the plugin under test and the plugins it builds on -->
        <dependency>
            <groupId>consulo.plugin</groupId>
            <artifactId>consulo.google.go</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
