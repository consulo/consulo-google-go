<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>consulo</groupId>
        <artifactId>arch.bind.java</artifactId>
        <version>3-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>consulo.plugin</groupId>
    <artifactId>consulo.google.go.it</artifactId>
    <version>3-SNAPSHOT</version>

    <!--
      Integration tests of the Go modules project system. Test sources only and no module-info.java: the headless
      harness discovers @ExtensionImpl/@ServiceImpl bindings through a classpath ServiceLoader, which skips providers
      in named modules. Nothing here ships.

      The tests run the real go binary over the fixtures in src/test/resources/fixtures and are skipped when go is not
      on PATH. The fixtures need no network: third-party modules are provided through local replace directives.
    -->

    <repositories>
        <repository>
            <id>consulo</id>
            <url>https://maven.consulo.dev/repository/snapshots/</url>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>interval:60</updatePolicy>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <environmentVariables>
                        <GOPROXY>off</GOPROXY>
                        <GOFLAGS></GOFLAGS>
                        <GOWORK></GOWORK>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- the headless application, projects and modules -->
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-it</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- the Go plugin compiles against these with the provided scope, the test classpath has to carry them -->
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-external-system-api</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-module-ui-api</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-version-control-system-api</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-language-editor-refactoring-api</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-language-code-style-ui-api</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-find-api</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-external-service-api</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-execution-test-sm-api</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-module-creation-api</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-execution-test-api</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-execution-coverage-api</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-compiler-api</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-build-ui-api</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-ide-api</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- the import and the tasks run the real go binary -->
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-process-impl</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- the external system reports its progress through the build view services -->
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-build-ui-impl</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- the platform module data service keeps the compiler output paths of imported modules -->
