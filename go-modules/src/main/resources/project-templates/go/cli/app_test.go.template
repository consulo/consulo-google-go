package app

import (
	"reflect"
	"strings"
	"testing"
)

func TestCountWordsAndTop(t *testing.T) {
	counts, err := CountWords(strings.NewReader("go Go gopher go\ngopher"))
	if err != nil {
		t.Fatal(err)
	}
	want := []WordCount{{"go", 3}, {"gopher", 2}}
	if got := Top(counts, 2); !reflect.DeepEqual(got, want) {
		t.Errorf("Top() = %v, want %v", got, want)
	}
}
